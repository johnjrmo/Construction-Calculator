<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEASURE WITH CONFIDENCE"
            android:textColor="@color/coral"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Construction Calculator"
            android:textColor="@color/ink"
            android:textSize="34sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Enter the two legs in feet and inches. Get the diagonal and angles instantly."
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/triangleTabButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:text="Triangle"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
            <Button
                android:id="@+id/feetInchesTabButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:text="Feet &amp; inches"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
            <Button
                android:id="@+id/volumeTabButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:text="Material"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/triangleContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/panel"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Triangle dimensions" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Leg A" android:textColor="@color/ink" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <EditText android:id="@+id/legAFeet" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="number" android:padding="12dp" android:singleLine="true" android:contentDescription="Leg A feet" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="ft" android:textColor="@color/muted" />
                <EditText android:id="@+id/legAInches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="numberDecimal" android:padding="12dp" android:singleLine="true" android:contentDescription="Leg A inches" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="in" android:textColor="@color/muted" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Leg B" android:textColor="@color/ink" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <EditText android:id="@+id/legBFeet" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="number" android:padding="12dp" android:singleLine="true" android:contentDescription="Leg B feet" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="ft" android:textColor="@color/muted" />
                <EditText android:id="@+id/legBInches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="numberDecimal" android:padding="12dp" android:singleLine="true" android:contentDescription="Leg B inches" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="in" android:textColor="@color/muted" />
            </LinearLayout>
            <Button android:id="@+id/calculateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/button_background" android:text="Calculate triangle" android:textAllCaps="false" android:textColor="@android:color/white" />
            <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="8dp" android:textColor="@color/coral" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Use decimal inches for fractions, such as 6.5 for 6 1/2 inches." android:textColor="@color/muted" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/panel" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Results" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Waiting for dimensions" android:textColor="@color/muted" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="HYPOTENUSE" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/hypotenuse" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ANGLE A" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" /><TextView android:id="@+id/angleA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" /></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ANGLE B" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" /><TextView android:id="@+id/angleB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" /></LinearLayout>
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/feetInchesContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Feet and inches calculator" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Combine two measurements with a basic operation." android:textColor="@color/muted" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="First measurement" android:textColor="@color/ink" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <EditText android:id="@+id/firstFeet" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="number" android:padding="12dp" android:singleLine="true" android:contentDescription="First measurement feet" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="ft" android:textColor="@color/muted" />
                <EditText android:id="@+id/firstInches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="numberDecimal" android:padding="12dp" android:singleLine="true" android:contentDescription="First measurement inches" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="in" android:textColor="@color/muted" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Operation" android:textColor="@color/ink" android:textStyle="bold" />
            <Spinner android:id="@+id/operationSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:entries="@array/operations" android:contentDescription="Operation" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Second measurement" android:textColor="@color/ink" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <EditText android:id="@+id/secondFeet" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="number" android:padding="12dp" android:singleLine="true" android:contentDescription="Second measurement feet" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="ft" android:textColor="@color/muted" />
                <EditText android:id="@+id/secondInches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="numberDecimal" android:padding="12dp" android:singleLine="true" android:contentDescription="Second measurement inches" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="in" android:textColor="@color/muted" />
            </LinearLayout>
            <Button android:id="@+id/feetInchesCalculateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/button_background" android:text="Calculate" android:textAllCaps="false" android:textColor="@android:color/white" />
            <TextView android:id="@+id/feetInchesError" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="8dp" android:textColor="@color/coral" android:textSize="12sp" />
            <TextView android:id="@+id/feetInchesSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Waiting for measurements" android:textColor="@color/muted" android:textSize="12sp" />
            <TextView android:id="@+id/feetInchesResult" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" android:textColor="@color/ink" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/volumeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Material required" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Find the cubic yards needed to fill a 3D area." android:textColor="@color/muted" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Height" android:textColor="@color/ink" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <EditText android:id="@+id/heightFeet" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="number" android:padding="12dp" android:singleLine="true" android:contentDescription="Height feet" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="ft" android:textColor="@color/muted" />
                <EditText android:id="@+id/heightInches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="numberDecimal" android:padding="12dp" android:singleLine="true" android:contentDescription="Height inches" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="in" android:textColor="@color/muted" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Width" android:textColor="@color/ink" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <EditText android:id="@+id/widthFeet" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="number" android:padding="12dp" android:singleLine="true" android:contentDescription="Width feet" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="ft" android:textColor="@color/muted" />
                <EditText android:id="@+id/widthInches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="numberDecimal" android:padding="12dp" android:singleLine="true" android:contentDescription="Width inches" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="in" android:textColor="@color/muted" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Length" android:textColor="@color/ink" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <EditText android:id="@+id/lengthFeet" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="number" android:padding="12dp" android:singleLine="true" android:contentDescription="Length feet" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="ft" android:textColor="@color/muted" />
                <EditText android:id="@+id/lengthInches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/input_background" android:hint="0" android:inputType="numberDecimal" android:padding="12dp" android:singleLine="true" android:contentDescription="Length inches" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="-32dp" android:text="in" android:textColor="@color/muted" />
            </LinearLayout>
            <Button android:id="@+id/volumeCalculateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/button_background" android:text="Calculate material" android:textAllCaps="false" android:textColor="@android:color/white" />
            <TextView android:id="@+id/volumeError" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="8dp" android:textColor="@color/coral" android:textSize="12sp" />
            <TextView android:id="@+id/volumeSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Waiting for dimensions" android:textColor="@color/muted" android:textSize="12sp" />
            <TextView android:id="@+id/volumeResult" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" android:textColor="@color/ink" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Convert to tons" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Material" android:textColor="@color/ink" android:textStyle="bold" />
            <Spinner android:id="@+id/materialSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:entries="@array/materials" android:contentDescription="Material type" />
            <TextView android:id="@+id/tonsSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Tons calculated from material volume" android:textColor="@color/muted" android:textSize="12sp" />
            <TextView android:id="@+id/tonsResult" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" android:textColor="@color/ink" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Approximate factors: sand 1.4, gravel 1.5, concrete 2.0 tons per cubic yard." android:textColor="@color/muted" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
